// use prisma-8

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  name         String?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Client {
  id             String   @id @default(uuid())
  nombre         String
  dni            String?
  telefono       String?
  telefonoAlt    String?
  email          String?
  ocupacion      String?
  fechaNacimiento String?
  estadoCivil    String?
  direccion      String?
  localidad      String?
  observaciones  String?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
  
  cases          Case[]
}

model Asociado {
  id             String   @id @default(uuid())
  nombre         String   @unique
  tipo           String?  // Ej: "Abogado", "Estudio", "Mutual"
  telefono       String?
  email          String?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  cases          Case[]
}

model Materia {
  id             String   @id @default(uuid())
  nombre         String   @unique
  descripcion    String?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  cases          Case[]
}

model Juzgado {
  id             String   @id @default(uuid())
  nombre         String   @unique
  ubicacion      String?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  cases          Case[]
}

model Case {
  id                 String   @id @default(uuid())
  clientId           String
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  caratula           String?
  
  materiaId          String?
  materia            Materia? @relation(fields: [materiaId], references: [id])
  
  estudio            String?
  
  asociadoId         String?
  asociado           Asociado? @relation(fields: [asociadoId], references: [id])
  
  estado             String?
  moroso             Boolean  @default(false)
  
  fechaEntrevista    String?
  horaEntrevista     String?
  atendidoPor        String?
  referidoPor        String?
  
  detalleAsunto      String?
  descripcionCaso    String?
  notasEntrevista    String?
  
  modalidadTrabajo   String?
  plazoEstimado      String?
  tareas             String?
  tareasDetalle      String?
  
  fechaFinalizacion  String?
  proximoMovimiento  String?
  
  juzgadoId          String?
  juzgado            Juzgado? @relation(fields: [juzgadoId], references: [id])
  
  contraparte        String?
  fechaInicio        String?
  nroExpediente      String?
  honorariosTotales  Float?
  honorariosDolares  Float?
  honorariosJus      Float?
  anticipo           Float?
  cuotasPactadas     Int?
  interesCuotas      Float?
  
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()

  fees               Fee[]
  contributions      Contribution[]
  expenses           Expense[]
}

model Fee {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  moneda    String?  @default("Pesos")
  monto     Float
  fechaVenc String?
  fechaPago String?
  metodo    String?
  recibo    String?
  notas     String?
  archivoUrl String?
}

model Contribution {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  concepto  String
  monto     Float
  fechaVenc String?
  fechaPago String?
  comprobante String?
  notas     String?
}

model Expense {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  concepto  String
  monto     Float
  fecha     String?
  comprobante String?
  notas     String?
  archivoUrl String?
}

model Setting {
  key       String   @id
  value     String
  updatedAt temporal.updatedAtString()
}
